# ------------------------------------------------------------------
# Aptil environment configuration. Copy to `.env` and fill in values.
# NEVER commit the real .env.
# ------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development            # development | staging | production
PROJECT_NAME=Aptil
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins (browser CORS).
BACKEND_CORS_ORIGINS=http://localhost:3000
# Production only: the bare domain Caddy should serve and obtain a certificate
# for. www is added automatically. Leave unset for local development.
APP_DOMAIN=
# Uvicorn processes for the API. Each holds a full copy of the app (~200MB), so
# size this to the server: 2 on a 2GB box, 4 on 4GB, (2 x vCPU) + 1 beyond that.
API_WORKERS=2
# Public URL of the web app. Used for links in email and the OAuth redirect
# back into the app. Keep this separate from CORS origins.
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated IPs/CIDRs of reverse proxies you trust. X-Forwarded-For is
# only honoured when the direct peer is in this list — otherwise anyone could
# spoof the header and bypass rate limits. Behind the bundled Caddy setup, use
# the Docker bridge network, e.g. 172.16.0.0/12
TRUSTED_PROXY_IPS=

# NOTE ON `$` IN VALUES: docker compose substitutes $NAME inside .env, so a
# secret containing a literal `$` arrives at the container TRUNCATED and you get
# an opaque auth failure. Escape it by doubling: `pa$$word` for a literal
# `pa$word`. The app warns at startup if a `$$` survives that far.

# --- Security ---
# Generate with: openssl rand -hex 32
# Production refuses to boot if this is unset, a placeholder, or under 32 chars.
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Key-encryption key for stored site credentials. Credentials are envelope
# encrypted: a random per-secret data key encrypts the password, and this key
# encrypts that data key — so rotating this only re-wraps 32 bytes per row.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key
# Previous keys, comma-separated, newest first. DECRYPT ONLY — nothing is ever
# written under them. To rotate: mint a new key, move the current one here,
# restart, run `python -m scripts.rotate_credential_key --apply`, then clear this.
CREDENTIAL_ENCRYPTION_KEYS_OLD=
# Max résumé upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# --- MongoDB ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=aptil

# --- Redis (Celery broker + rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO / AWS S3 / Cloudflare R2) ---
# These are generic S3 settings despite the MINIO_ prefix. For AWS S3 leave
# MINIO_ENDPOINT empty and set MINIO_REGION to the bucket's region.
# See docs/storage-s3.md.
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=aptil
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=aptil-uploads
MINIO_SECURE=false
# Part of the SigV4 signature — a wrong region gives SignatureDoesNotMatch.
MINIO_REGION=us-east-1

# --- Email (transactional; verification + password reset + notifications) ---
# With SMTP_HOST empty, emails are LOGGED instead of sent (fine for local dev,
# refused in production).
SMTP_HOST=
SMTP_PORT=587                      # 465 uses implicit TLS; 587 uses STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aptil.ai
SMTP_TLS=true

# --- Google OAuth (optional; sign-in button hides itself when unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- AI providers (LiteLLM). Comma-separated key pools for rotation/failover. ---
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
XAI_API_KEYS=                      # Grok
GROQ_API_KEYS=
OLLAMA_BASE_URL=http://ollama:11434
# Default model routing (LiteLLM model strings)
LLM_DEFAULT_MODEL=anthropic/claude-sonnet-5
LLM_FALLBACK_MODELS=openai/gpt-4o-mini,groq/llama-3.3-70b-versatile
# Hard cap on questions per generated interview (cost guard).
MAX_INTERVIEW_QUESTIONS=20

# --- Payments ---
STRIPE_SECRET_KEY=
# Required for the webhook to be accepted at all — unsigned webhooks are rejected.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/plans?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/plans?checkout=cancelled

# --- Job sources ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Web-search job discovery (primary source; aggregator-independent) ---
# Finds postings across the OPEN WEB via a real search API, not by scraping a
# search engine's result page. Get a key from https://brave.com/search/api/
# (free tier available). Empty key disables web search.
WEB_SEARCH_PROVIDER=serper
# Required for serper/tavily/brave. Leave EMPTY for searxng (it needs no key).
WEB_SEARCH_API_KEY=
# Optional. Each provider has a sensible default; set only to self-host searxng
# (e.g. http://searxng:8080/search) or route through a proxy.
WEB_SEARCH_ENDPOINT=
SOURCING_WEB_SEARCH=true
# Adzuna is OPTIONAL and off by default — web search is the web-wide source.
# Turn on only if you also want Adzuna's aggregated feed (needs ADZUNA_* keys).
SOURCING_USE_ADZUNA=false
# Free remote-job boards (RemoteOK, Remotive, Himalayas, Arbeitnow, WeWork-
# Remotely) as ADDITIONAL sources. No API keys. Results pass the same per-user
# role/country/dedupe gates, so this only widens coverage. If a board blocks
# direct fetching, the connector falls back to headless Chromium automatically.
SOURCING_REMOTE_BOARDS=true

# --- Managed apply email + auto account creation (optional) ---
# Give each user an alias u-<id>@APPLY_EMAIL_DOMAIN so Aptil can create job-site
# accounts for them (no user password needed) and receive employer replies. Set
# up a catch-all on this domain (Cloudflare Email Routing) pointing its worker
# at POST /api/v1/inbound/email. Leave APPLY_EMAIL_DOMAIN empty to disable both
# the aliases and auto-registration.
APPLY_EMAIL_DOMAIN=
# HMAC secret shared with the inbound-email worker. Required when the domain is
# set. Generate: openssl rand -hex 32
INBOUND_EMAIL_SECRET=
# Whether new users default to letting Aptil create accounts for them.
AUTO_CREATE_ACCOUNTS_DEFAULT=true
# Country (ISO-2) for per-user aggregator search when the user set no location.
DEFAULT_JOB_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=            # a registered contact email, per USAJOBS API rules

# --- Matching quality ---
# Only create applications for jobs scoring at least this. Raise for fewer,
# better matches; lower for more, weaker ones.
MIN_MATCH_SCORE=0.55
# Cap how many results one employer may take in a single matching run. Without
# this, whichever board has the most postings takes over the dashboard.
MAX_MATCHES_PER_COMPANY=3
# Cap how many postings one connector run adds to the shared pool, so a large
# company board cannot swamp it.
MAX_POSTINGS_PER_SOURCE=300
# Sustainability cache: don't re-hit a board/API for a (source, query) fetched
# within this many hours — every user targeting the same role reuses one fetch.
# 24h refreshes daily; raise toward 168 (7 days) for maximum API reduction at
# the cost of freshness; 0 disables the cache.
JOB_CACHE_TTL_HOURS=24
# Expire a job from the pool this many days after it was last seen (re-seeing it
# refreshes it). Keeps the pool fresh and bounded. 0 disables expiry.
JOB_RETENTION_DAYS=7
# Cap on how many search queries one user's sourcing run may fire (titles x
# countries), so targeting a whole continent cannot exhaust the search-API quota.
MAX_DEMAND_QUERIES=40

# --- Scheduler (Celery beat) ---
# Minutes between each periodic sweep. Set to 0 to disable that sweep.
SOURCING_INTERVAL_MINUTES=60
MATCHING_INTERVAL_MINUTES=30
APPLY_INTERVAL_MINUTES=15
# OPTIONAL operator escape hatch: pull from a SPECIFIC company board in addition
# to each user's CV-driven web search. Leave EMPTY ([]) for normal use — there
# is deliberately NO default board list; discovery is the user's own web search.
# Only add an entry to force-include one company's board. Examples:
#   [{"source":"greenhouse","query":{"board":"acme","company":"Acme"}},
#    {"source":"lever","query":{"company":"acme","company_name":"Acme"}}]
# Greenhouse/Lever/Ashby board endpoints are public and need no API key. The
# board/company value is the slug from the company's careers URL. Verify a slug
# before adding it — a wrong one 404s and is silently skipped:
#   curl -s https://boards-api.greenhouse.io/v1/boards/<slug>/jobs | head -c 200
# Workday needs the tenant + careers-site tokens from the careers URL:
#   https://{tenant}.{dc}.myworkdayjobs.com/en-US/{site}/...
#   {"source":"workday","query":{"tenant":"nvidia","dc":"wd5","site":"NVIDIAExternalCareerSite","company":"NVIDIA"}}
# Note: Workday postings are discovered and matched, but its application is a
# multi-page wizard we do not complete — those rows park for you to finish.
SOURCING_JOBS_JSON=[]

# --- Frontend ---
# Two ways for the browser to reach the API. Pick one.
#
# 1) DIRECT (this is what docker-compose uses locally). Inlined into the browser
#    bundle at BUILD time, so changing it requires rebuilding the web image.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# 2) SAME-ORIGIN PROXY (recommended behind a single host, e.g. Render). Leave
#    NEXT_PUBLIC_API_BASE_URL empty and set this to the API's internal URL; the
#    Next server proxies /api/* to it. Nothing is baked into the bundle and there
#    is no CORS to configure. Read at server start, not build time.
# API_PROXY_TARGET=http://api:8000

# --- Host port mappings for docker-compose (local only) ---
# These change ONLY what your own machine can reach. Containers always reach
# each other on the compose network (mongo:27017, redis:6379, minio:9000), so
# remapping these never breaks the app.
#
# Bump any that collide with something already running on your machine — a
# native mongod or redis is the usual culprit, and the symptom is:
#   Error response from daemon: ports are not available: ... bind: address already in use
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# Only used with `docker compose --profile ollama up`.
OLLAMA_HOST_PORT=11434
