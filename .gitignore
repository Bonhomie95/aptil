# Data volumes (local). The bare `data/` pattern matches at ANY depth, which
# silently swallowed backend/app/data/job_boards.json — shipped source data, not
# a volume. Anchored to the repo root, with an explicit exception for the app's
# own data directory.
/data/
minio-data/
postgres-data/

# graphify build output
graphify-out/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Celery beat's local schedule database
celerybeat-schedule*
celerybeat.pid

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
